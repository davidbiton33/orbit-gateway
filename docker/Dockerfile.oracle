# ARM64 Oracle Ampere A1; Playwright's matching Chromium is included in the base image.
FROM --platform=linux/arm64 mcr.microsoft.com/playwright:v1.56.1-noble
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
  xvfb x11vnc novnc websockify dbus-x11 curl ca-certificates procps fonts-noto-core fonts-noto-color-emoji libreoffice-writer \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY ./src ./src
COPY ./bin ./bin
COPY ./config ./config
COPY ./public ./public
COPY ./docker ./docker
RUN chmod +x /app/docker/*.sh && mkdir -p /app/data
EXPOSE 4984 4983 6080
CMD ["bash","/app/docker/entrypoint.sh"]
