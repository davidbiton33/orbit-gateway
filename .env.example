# Generated automatically: DO NOT put account passwords here or commit .env.docker.
# Every fresh installation gets its own project name, random token and fresh Docker volumes.
COMPOSE_PROJECT_NAME=orbit-gateway-REPLACED_AT_SETUP
GATEWAY_TOKEN=GENERATED_AUTOMATICALLY_BY_SETUP
GPT_BACKEND=docker
ORBIT_UI_PORT=4983
ORBIT_API_PORT=4984
ORBIT_GPT_LEGACY_VNC_PORT=6080
ORBIT_GPT_VNC_PORT=6081
ORBIT_GEMINI_VNC_PORT=6082
# Legacy now uses its OWN Docker-managed volume. No old/external profiles mounted.
