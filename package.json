{
  "name": "orbit-gateway",
  "version": "2.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node bin/gateway.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "login:gpt": "node bin/gateway.mjs login gpt",
    "login:gemini": "node bin/gateway.mjs login gemini",
    "update": "node bin/gateway.mjs update"
  },
  "dependencies": {
    "playwright": "1.56.1"
  },
  "bin": {
    "gateway": "./bin/gateway.mjs"
  },
  "description": "Private browser-backed AI Gateway",
  "license": "MIT"
}
