{
  "name": "unified-ai-gateway-private",
  "version": "2.1.4-docker.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node bin/gateway.mjs doctor",
    "test": "node --test tests/*.test.mjs",
    "login:claude": "node bin/gateway.mjs login claude",
    "login:gpt": "node bin/gateway.mjs login gpt",
    "login:gemini": "node bin/gateway.mjs login gemini",
    "update": "node bin/gateway.mjs update"
  },
  "dependencies": {
    "playwright": "1.56.1"
  },
  "bin": {
    "gateway": "./bin/gateway.mjs"
  }
}
